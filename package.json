{
  "name": "sharecon-ai",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:report": "playwright show-report",
    "generate:benchmark": "tsx scripts/generate-benchmark-artifacts.ts",
    "generate:heldout": "tsx scripts/generate-held-out-artifacts.ts",
    "benchmark:performance": "tsx scripts/measure-performance.ts",
    "benchmark:partitions": "tsx scripts/benchmark-partitions.ts",
    "verify:artifacts": "git diff --exit-code HEAD -- docs/generated/benchmark.json docs/generated/benchmark.md docs/evaluation",
    "verify": "npm run lint && npm run type-check && npm run test && npm run generate:benchmark && npm run generate:heldout && npm run verify:artifacts && npm run build && npm run test:e2e"
  },
  "engines": {
    "node": "20.x",
    "npm": "10.x"
  },
  "volta": {
    "node": "20.18.3",
    "npm": "10.9.2"
  },
  "dependencies": {
    "@google/genai": "^2.18.0",
    "clsx": "^2.1.1",
    "lucide-react": "^1.33.0",
    "next": "16.3.2",
    "papaparse": "^5.6.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9",
    "eslint-config-next": "16.3.2",
    "jsdom": "^26.0.0",
    "playwright": "^1.62.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "vitest": "^3.0.7"
  }
}
